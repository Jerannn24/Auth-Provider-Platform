
# Don't change anything below unless you know what you're doing
# except for the JWT_SECRET, which you should change to a secure random string in production
NODE_ENV=development

# Healthcheck configuration for PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB_GLOBAL=postgres
POSTGRES_DB_APPLICATION_A=app_a
POSTGRES_DB_APPLICATION_B=app_b
PORT=5432

# URL Database, sesuaikan nama database dan port sesuai kebutuhan
DATABASE_URL_GLOBAL=postgresql://postgres:123@postgres-db:5432/postgres?schema=public
DATABASE_URL_LOCAL_A=postgresql://postgres:123@postgres-db:5432/app_a?schema=public
DATABASE_URL_LOCAL_B=postgresql://postgres:123@postgres-db:5432/app_b?schema=public

CLIENT_ID_A=app-a
CLIENT_ID_B=app-b

# Client mustn't be the same for different app and pushed on .env.example
# you can change this secret but don't forget to change it in seed.ts
CLIENT_SECRET_A=app-a-secret
CLIENT_SECRET_B=app-b-secret

JWT_SECRET={JWT_SECRET} # Change this to a secure random string in production